# MiMo-V2.6-Flash-MOPD bf16-KV profile on the four-Spark ring (vLLM TP4): production 2026-10-01 to 2026-10-03,
# kept as the alternative to profile.env's FP8 KV cache (exact bf16 KV numerics, faster prefill, half the KV pool).
# Read by ring-up.sh, which passes every line to vllm-rank.sh as environment. KEY=VALUE only, one per line,
# comments on their own lines (an inline comment would become part of the value).
#
# History (README "What each overlay changes"):
#   2026-09-29 launch: MTP K=3 (non-chained), --linear-backend triton, 16K batched tokens, 32 seats, 512K context,
#     KV 24 GB/rank, vllm#58235 (vllm-patches), dual-PCI-domain NCCL over four RoCE functions.
#   2026-09-30: GB10 TRITON_ATTN_DIFFKV launch tuning + QK split (vllm-patches-attn2), GB10 block-FP8 GEMM configs
#     (vllm-patches-fp8cfg), the vllm#58019 tool-parser port (vllm-patches-tools), NCCL 4 channels, 64 seats,
#     KV 30 GB/rank (pool 3.96M tokens) and max_model_len 1,048,576.
#   2026-10-01: TP all-reduces <= 1 MB on ring-only RoCEnante recursive doubling (vllm-patches-roce + b12x e4084d2e).
# Other profiles: profile.env (FP8 KV, production since 2026-10-03), profile.rollback-20260930.env (no RoCE),
# profile.launch-20260929.env (launch day).

# API port on rank 0 (vllm-rank.sh's default 8025 is the test port).
PORT=8015
# Patched NCCL over all four RoCE functions (both PCIe domains of both ports).
NCCL_DUAL=1
# CUTLASS FP8 linear rejects the per-rank (4096, 3392) QKV at TP4 -> Triton; 16K batched tokens: +38 % prefill at 8K.
VLLM_EXTRA=--linear-backend=triton,--max-num-batched-tokens=16384
# KV cache bytes per rank: 3,963,635 tokens in the pool (3.78 x 1M).
KV_BYTES=30000000000
MAX_LEN=1048576
MAX_SEQS=64
# Each of the 3 MTP layers reads the target hidden states (myllmbox image switch).
MBX_MTP_NONCHAIN=1
# overlays/vllm-patches (vllm#58235) plus the tuning overlays, all sha-checked before mounting.
VLLM_PATCHES=1
VLLM_PATCHES_EXTRA=vllm-patches-attn2,vllm-patches-fp8cfg,vllm-patches-tools,vllm-patches-roce
# b12x checkout for RoCEnante: $B12X_ROOT/e4084d2e at local-inference-lab/b12x e4084d2eef4932e0fa06db3f7a94deb83ad132d7.
B12X=e4084d2e
# NCCL 4 channels (the default choice is 2.7-5.3x slow at 512 KB-1 MB); RoCE recursive doubling for <= 1 MB.
VLLM_ENV=NCCL_MIN_NCHANNELS=4,NCCL_MAX_NCHANNELS=4,MIMO_ROCE_RD=1,MIMO_ROCE_RD_MAX=1048576
