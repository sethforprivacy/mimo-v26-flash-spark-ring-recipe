# Launch-day profile (2026-09-29): the A/B winner, before any GB10 tuning. The "launch" column of the README's
# results table was measured on this profile. 512K context, 32 seats, KV 24 GB/rank (pool 2,559,289 tokens),
# only vllm#58235 mounted (vllm-patches), NCCL's default channel choice, every TP all-reduce on NCCL.
PORT=8015
NCCL_DUAL=1
VLLM_EXTRA=--linear-backend=triton,--max-num-batched-tokens=16384
KV_BYTES=24000000000
MAX_LEN=524288
MAX_SEQS=32
MBX_MTP_NONCHAIN=1
VLLM_PATCHES=1
