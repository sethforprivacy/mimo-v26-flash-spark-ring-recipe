# Rollback profile: production as of 2026-09-30 20:40Z to 2026-10-01 18:40Z, i.e. profile.env without RoCEnante
# (no vllm-patches-roce, no B12X, no MIMO_ROCE_RD*). Every TP all-reduce runs on NCCL. Use:
#   PROFILE=launcher/profile.rollback-20260930.env launcher/ring-up.sh up      (after a reboot of all four nodes)
PORT=8015
NCCL_DUAL=1
VLLM_EXTRA=--linear-backend=triton,--max-num-batched-tokens=16384
KV_BYTES=30000000000
MAX_LEN=1048576
MAX_SEQS=64
MBX_MTP_NONCHAIN=1
VLLM_PATCHES=1
VLLM_PATCHES_EXTRA=vllm-patches-attn2,vllm-patches-fp8cfg,vllm-patches-tools
VLLM_ENV=NCCL_MIN_NCHANNELS=4,NCCL_MAX_NCHANNELS=4
